include LICENSE
include THIRD_PARTY.md
include README.md
include RELEASING.md
include pyproject.toml
include setup.py
recursive-include csrc *.c *.h *.m *.txt
recursive-include src/nexa *.py py.typed
prune src/nexa/_native
prune docs
prune wiki
prune examples
prune tests
global-exclude *.so *.dylib *.dll *.pyd *.o *.obj *.pyc *.pyo __pycache__
